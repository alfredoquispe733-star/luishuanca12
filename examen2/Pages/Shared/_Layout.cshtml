<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - examen2</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light">
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-success shadow-sm mb-3">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-page="/Proyectos/Index">Proyectos &amp; Jefes</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-page="/Proyectos/Index">Proyectos</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-page="/Jefes/Index">Jefes</a>
                        </li>
                    </ul>
                    <ul class="navbar-nav">
                        @{
                            var usuarioActual = Context.Session.GetString("NombreUsuario");
                        }
                        @if (!string.IsNullOrEmpty(usuarioActual))
                        {
                            <li class="nav-item d-flex align-items-center me-3 text-white small">
                                Hola, @usuarioActual
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-outline-light btn-sm" asp-page="/Auth/Logout">Salir</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item me-2">
                                <a class="btn btn-outline-light btn-sm" asp-page="/Auth/Login">Iniciar Sesión</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-light btn-sm text-success fw-semibold" asp-page="/Auth/Registro">Registrarse</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="pb-4">
        @RenderBody()
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>