@page
@model examen2.Pages.Proyectos.CreateModel
@{
    ViewData["Title"] = "Nuevo Proyecto - Gestión de Proyectos";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-success">
                <div class="card-header bg-success text-white">
                    <strong>Crear Nuevo Proyecto</strong>
                </div>
                <div class="card-body p-4">
                    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                    {
                        <div class="alert alert-danger">@Model.ErrorMessage</div>
                    }

                    <form method="post">
                        <div class="mb-3">
                            <label asp-for="NuevoProyecto.Nombre" class="form-label">Nombre</label>
                            <input asp-for="NuevoProyecto.Nombre" class="form-control" required />
                        </div>

                        <div class="mb-3">
                            <label asp-for="NuevoProyecto.Descripcion" class="form-label">Descripción</label>
                            <textarea asp-for="NuevoProyecto.Descripcion" class="form-control" rows="3" required></textarea>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NuevoProyecto.Estado" class="form-label">Estado</label>
                            <select asp-for="NuevoProyecto.Estado" class="form-select" required>
                                <option value="Activo">Activo</option>
                                <option value="En progreso">En progreso</option>
                                <option value="Pendiente">Pendiente</option>
                                <option value="Finalizado">Finalizado</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NuevoProyecto.IdJefe" class="form-label">Jefe Asignado (1 por proyecto)</label>
                            <select asp-for="NuevoProyecto.IdJefe" class="form-select" required>
                                <option value="">-- Selecciona un jefe --</option>
                                @foreach (var jefe in Model.Jefes)
                                {
                                    <option value="@jefe.Id">@jefe.Nombre (@jefe.Cargo)</option>
                                }
                            </select>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-success w-100">Guardar</button>
                            <a asp-page="/Proyectos/Index" class="btn btn-outline-secondary">Volver</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>