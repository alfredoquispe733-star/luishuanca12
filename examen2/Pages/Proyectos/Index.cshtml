@page
@model examen2.Pages.Proyectos.IndexModel
@{
    ViewData["Title"] = "Proyectos - Gestión de Proyectos";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-success mb-0">Proyectos</h2>
        <a asp-page="/Jefes/Index" class="btn btn-outline-success">Gestionar Jefes</a>
    </div>

    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @Model.StatusMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @Model.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Buscar proyecto por ID y mostrar su jefe -->
    <div class="card shadow-sm border-success mb-4">
        <div class="card-header bg-success text-white">
            <strong>Buscar Proyecto por ID y Ver Jefe Asignado</strong>
        </div>
        <div class="card-body">
            <form method="get" class="row g-2 align-items-end">
                <div class="col-md-8">
                    <label for="buscarId" class="form-label">ID del Proyecto (GUID)</label>
                    <input id="buscarId" name="buscarId" value="@Model.BuscarId?.ToString()" class="form-control" placeholder="Ej. 3fa85f64-5717-4562-b3fc-2c963f66afa6" />
                </div>
                <div class="col-md-4 d-flex gap-2">
                    <button type="submit" class="btn btn-success w-100">Buscar</button>
                    @if (Model.BuscarId.HasValue)
                    {
                        <a asp-page="/Proyectos/Index" class="btn btn-outline-secondary">Limpiar</a>
                    }
                </div>
            </form>

            @if (!string.IsNullOrEmpty(Model.BuscarError))
            {
                <div class="alert alert-warning mt-3 mb-0">@Model.BuscarError</div>
            }

            @if (Model.ProyectoBuscado != null)
            {
                <div class="mt-3 p-3 rounded bg-success bg-opacity-10 border border-success">
                    <h5 class="text-success mb-2">@Model.ProyectoBuscado.Nombre</h5>
                    <p class="mb-1"><strong>ID:</strong> @Model.ProyectoBuscado.Id</p>
                    <p class="mb-1"><strong>Descripción:</strong> @Model.ProyectoBuscado.Descripcion</p>
                    <p class="mb-2"><strong>Estado:</strong> <span class="badge bg-success">@Model.ProyectoBuscado.Estado</span></p>
                    <hr class="my-2" />
                    @if (Model.ProyectoBuscado.Jefe != null)
                    {
                        <p class="mb-1"><strong>Jefe a cargo:</strong> @Model.ProyectoBuscado.Jefe.Nombre</p>
                        <p class="mb-1"><strong>Cargo:</strong> @Model.ProyectoBuscado.Jefe.Cargo</p>
                        <p class="mb-0"><strong>Correo:</strong> @Model.ProyectoBuscado.Jefe.Correo</p>
                    }
                    else
                    {
                        <p class="mb-0 text-muted">Sin jefe asignado.</p>
                    }
                </div>
            }
        </div>
    </div>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="card shadow-sm border-success">
                <div class="card-header bg-success text-white">
                    <strong>Crear Nuevo Proyecto</strong>
                </div>
                <div class="card-body">
                    <form method="post">
                        <div class="mb-3">
                            <label asp-for="NuevoProyecto.Nombre" class="form-label">Nombre</label>
                            <input asp-for="NuevoProyecto.Nombre" class="form-control" required />
                        </div>

                        <div class="mb-3">
                            <label asp-for="NuevoProyecto.Descripcion" class="form-label">Descripción</label>
                            <textarea asp-for="NuevoProyecto.Descripcion" class="form-control" rows="2" required></textarea>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NuevoProyecto.Estado" class="form-label">Estado</label>
                            <select asp-for="NuevoProyecto.Estado" class="form-select" required>
                                <option value="Activo">Activo</option>
                                <option value="En progreso">En progreso</option>
                                <option value="Pendiente">Pendiente</option>
                                <option value="Finalizado">Finalizado</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NuevoProyecto.IdJefe" class="form-label">Jefe Asignado (1 por proyecto)</label>
                            <select asp-for="NuevoProyecto.IdJefe" class="form-select" required>
                                <option value="">-- Selecciona un jefe --</option>
                                @foreach (var jefe in Model.Jefes)
                                {
                                    <option value="@jefe.Id">@jefe.Nombre (@jefe.Cargo)</option>
                                }
                            </select>
                        </div>

                        <button type="submit" class="btn btn-success w-100">Guardar Proyecto</button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-8">
            <div class="card shadow-sm border-success">
                <div class="card-header bg-success bg-opacity-10 text-success">
                    <strong>Listado de Proyectos (@Model.Proyectos.Count)</strong>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover table-striped mb-0 align-middle">
                            <thead class="table-success">
                                <tr>
                                    <th>Nombre</th>
                                    <th>Estado</th>
                                    <th>Jefe</th>
                                    <th>Acción</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Proyectos.Count == 0)
                                {
                                    <tr>
                                        <td colspan="4" class="text-center text-muted py-4">No hay proyectos registrados.</td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var proyecto in Model.Proyectos)
                                    {
                                        <tr>
                                            <td>
                                                <div class="fw-semibold">@proyecto.Nombre</div>
                                                <small class="text-muted">@proyecto.Descripcion</small>
                                            </td>
                                            <td><span class="badge bg-success">@proyecto.Estado</span></td>
                                            <td>@(proyecto.Jefe?.Nombre ?? "Sin asignar")</td>
                                            <td>
                                                <a asp-page="/Proyectos/Index" asp-route-buscarId="@proyecto.Id" class="btn btn-sm btn-outline-success">
                                                    Ver detalle
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>