@page
@model examen2.Pages.Jefes.CreateModel
@{
    ViewData["Title"] = "Nuevo Jefe - Gestión de Proyectos";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow-sm border-success">
                <div class="card-header bg-success text-white">
                    <strong>Registrar Nuevo Jefe</strong>
                </div>
                <div class="card-body p-4">
                    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                    {
                        <div class="alert alert-danger">@Model.ErrorMessage</div>
                    }

                    <form method="post">
                        <div class="mb-3">
                            <label asp-for="NuevoJefe.Nombre" class="form-label">Nombre</label>
                            <input asp-for="NuevoJefe.Nombre" class="form-control" required />
                        </div>

                        <div class="mb-3">
                            <label asp-for="NuevoJefe.Cargo" class="form-label">Cargo</label>
                            <input asp-for="NuevoJefe.Cargo" class="form-control" required />
                        </div>

                        <div class="mb-3">
                            <label asp-for="NuevoJefe.Correo" class="form-label">Correo</label>
                            <input asp-for="NuevoJefe.Correo" type="email" class="form-control" required />
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-success w-100">Guardar</button>
                            <a asp-page="/Jefes/Index" class="btn btn-outline-secondary">Volver</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>